#!/bin/bash

# git-snapshot v2: Save and restore working directory snapshots
# Uses full file contents (not patches) for reliable restore

set -e

SNAPSHOTS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/git-snapshots"
SNAPSHOT_EXT=".snapshot"

# ============================================================================
# Helper Functions
# ============================================================================

generate_hash() {
    # Generate 8-char hash from current timestamp + random
    echo "$(date +%s%N)$RANDOM" | shasum | cut -c1-8
}

get_repo_remote() {
    git config --get remote.origin.url 2>/dev/null || echo ""
}

get_repo_path() {
    git rev-parse --show-toplevel 2>/dev/null
}

get_current_branch() {
    git rev-parse --abbrev-ref HEAD 2>/dev/null
}

get_current_commit() {
    git rev-parse HEAD 2>/dev/null
}

ensure_git_repo() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not in a git repository"
        exit 1
    fi
}

ensure_snapshots_dir() {
    mkdir -p "$SNAPSHOTS_DIR"
}

# Get metadata from a snapshot file
get_snapshot_metadata() {
    local snapshot_file="$1"
    tar -xzf "$snapshot_file" -O metadata.json 2>/dev/null
}

# Check if snapshot belongs to current repo
snapshot_matches_repo() {
    local metadata="$1"
    local current_remote=$(get_repo_remote)
    local current_path=$(get_repo_path)
    
    local snapshot_remote=$(echo "$metadata" | grep -o '"repo_remote"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    local snapshot_path=$(echo "$metadata" | grep -o '"repo_path"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    
    # Match by remote if both have one
    if [ -n "$current_remote" ] && [ -n "$snapshot_remote" ]; then
        [ "$current_remote" = "$snapshot_remote" ] && return 0 || return 1
    fi
    
    # Fallback to path match
    [ "$current_path" = "$snapshot_path" ] && return 0 || return 1
}

# Find snapshot files matching a query (hash, suffix, or full name)
find_snapshots() {
    local query="$1"
    local repo_filter="${2:-true}"  # filter by current repo by default
    
    if [ ! -d "$SNAPSHOTS_DIR" ]; then
        return
    fi
    
    local current_remote=$(get_repo_remote)
    local current_path=$(get_repo_path)
    
    for file in "$SNAPSHOTS_DIR"/*"$SNAPSHOT_EXT"; do
        [ -f "$file" ] || continue
        
        local basename=$(basename "$file" "$SNAPSHOT_EXT")
        
        # Check if matches query
        local matches=false
        
        # Exact match (full name without extension)
        if [ "$basename" = "$query" ]; then
            matches=true
        # Hash match (last segment before extension)
        elif [[ "$basename" == *".$query" ]] || [ "$basename" = "$query" ]; then
            matches=true
        # Suffix match (first part before hash)
        elif [[ "$basename" == "$query."* ]]; then
            matches=true
        fi
        
        if [ "$matches" = true ]; then
            # Filter by repo if requested
            if [ "$repo_filter" = true ]; then
                local metadata=$(get_snapshot_metadata "$file")
                if snapshot_matches_repo "$metadata"; then
                    echo "$file"
                fi
            else
                echo "$file"
            fi
        fi
    done
}

# List all snapshots for current repo
list_repo_snapshots() {
    if [ ! -d "$SNAPSHOTS_DIR" ]; then
        return
    fi
    
    for file in "$SNAPSHOTS_DIR"/*"$SNAPSHOT_EXT"; do
        [ -f "$file" ] || continue
        
        local metadata=$(get_snapshot_metadata "$file")
        if snapshot_matches_repo "$metadata"; then
            echo "$file"
        fi
    done
}

# ============================================================================
# Commands
# ============================================================================

show_help() {
    echo "git-snapshot - Save and restore working directory snapshots"
    echo ""
    echo "Usage:"
    echo "  git-snapshot [name]              Create a snapshot (optional name)"
    echo "  git-snapshot create [name]       Explicit create"
    echo "  git-snapshot list [--all]        List snapshots (default: current repo)"
    echo "  git-snapshot show <name>         Show snapshot contents"
    echo "  git-snapshot restore <name>      Restore a snapshot"
    echo "  git-snapshot delete <name> ...   Delete snapshot(s)"
    echo "  git-snapshot prune               Delete all snapshots for current repo"
    echo "  git-snapshot rename <name> <new> Rename a snapshot"
    echo "  git-snapshot help                Show this help"
    echo ""
    echo "Restore options:"
    echo "  --staged-only      Restore only staged changes"
    echo "  --unstaged-only    Restore only unstaged changes"
    echo "  --untracked-only   Restore only untracked files"
    echo ""
    echo "Examples:"
    echo "  git-snapshot my-feature          # Create snapshot"
    echo "  git-snapshot list                # List snapshots for this repo"
    echo "  git-snapshot restore my-feature  # Restore by name"
    echo "  git-snapshot restore a1b2c3d4    # Restore by hash"
}

create_snapshot() {
    local name="${1:-}"
    
    ensure_git_repo
    ensure_snapshots_dir
    
    local hash=$(generate_hash)
    local repo_remote=$(get_repo_remote)
    local repo_path=$(get_repo_path)
    local branch=$(get_current_branch)
    local commit=$(get_current_commit)
    local created_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Build filename
    local filename
    if [ -n "$name" ]; then
        filename="${name}.${hash}${SNAPSHOT_EXT}"
    else
        filename="${hash}${SNAPSHOT_EXT}"
    fi
    
    local snapshot_path="$SNAPSHOTS_DIR/$filename"
    
    # Create temp directory for building snapshot
    local temp_dir=$(mktemp -d)
    trap "rm -rf '$temp_dir'" EXIT
    
    mkdir -p "$temp_dir/staged"
    mkdir -p "$temp_dir/unstaged"
    mkdir -p "$temp_dir/untracked"
    
    local staged_files=()
    local unstaged_files=()
    local untracked_files=()
    
    # Get staged files (files in index that differ from HEAD)
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        staged_files+=("$file")
        
        # Get the staged version from index
        local dir=$(dirname "$file")
        mkdir -p "$temp_dir/staged/$dir"
        git show ":$file" > "$temp_dir/staged/$file" 2>/dev/null || true
    done < <(git diff --cached --name-only 2>/dev/null)
    
    # Get unstaged files (working tree differs from index)
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        unstaged_files+=("$file")
        
        # Copy the working tree version
        local dir=$(dirname "$file")
        mkdir -p "$temp_dir/unstaged/$dir"
        cp "$repo_path/$file" "$temp_dir/unstaged/$file" 2>/dev/null || true
    done < <(git diff --name-only 2>/dev/null)
    
    # Get untracked files
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        untracked_files+=("$file")
        
        # Copy the file
        local dir=$(dirname "$file")
        mkdir -p "$temp_dir/untracked/$dir"
        cp "$repo_path/$file" "$temp_dir/untracked/$file" 2>/dev/null || true
    done < <(git ls-files --others --exclude-standard 2>/dev/null)
    
    # Check if there's anything to save
    if [ ${#staged_files[@]} -eq 0 ] && [ ${#unstaged_files[@]} -eq 0 ] && [ ${#untracked_files[@]} -eq 0 ]; then
        echo "No changes to save"
        exit 0
    fi
    
    # Build metadata.json
    local staged_json=$(printf '%s\n' "${staged_files[@]}" | jq -R . | jq -s . 2>/dev/null || echo "[]")
    local unstaged_json=$(printf '%s\n' "${unstaged_files[@]}" | jq -R . | jq -s . 2>/dev/null || echo "[]")
    local untracked_json=$(printf '%s\n' "${untracked_files[@]}" | jq -R . | jq -s . 2>/dev/null || echo "[]")
    
    cat > "$temp_dir/metadata.json" << EOF
{
  "name": "$name",
  "hash": "$hash",
  "repo_remote": "$repo_remote",
  "repo_path": "$repo_path",
  "branch": "$branch",
  "commit": "$commit",
  "created_at": "$created_at",
  "staged_files": $staged_json,
  "unstaged_files": $unstaged_json,
  "untracked_files": $untracked_json
}
EOF
    
    # Create the snapshot tarball
    tar -czf "$snapshot_path" -C "$temp_dir" .
    
    echo "Snapshot created: $filename"
    echo ""
    echo "  Staged files:    ${#staged_files[@]}"
    echo "  Unstaged files:  ${#unstaged_files[@]}"
    echo "  Untracked files: ${#untracked_files[@]}"
    echo ""
    echo "Restore with:"
    if [ -n "$name" ]; then
        echo "  git-snapshot restore $name"
    else
        echo "  git-snapshot restore $hash"
    fi
}

list_snapshots() {
    local show_all=false
    
    if [ "$1" = "--all" ] || [ "$1" = "-a" ]; then
        show_all=true
    fi
    
    ensure_git_repo
    
    if [ ! -d "$SNAPSHOTS_DIR" ]; then
        echo "No snapshots found"
        exit 0
    fi
    
    local found=false
    local current_remote=$(get_repo_remote)
    local current_path=$(get_repo_path)
    
    if [ "$show_all" = true ]; then
        echo "All snapshots:"
    else
        echo "Snapshots for $(basename "$current_path"):"
    fi
    echo ""
    
    for file in "$SNAPSHOTS_DIR"/*"$SNAPSHOT_EXT"; do
        [ -f "$file" ] || continue
        
        local metadata=$(get_snapshot_metadata "$file")
        
        # Filter by repo unless --all
        if [ "$show_all" = false ]; then
            if ! snapshot_matches_repo "$metadata"; then
                continue
            fi
        fi
        
        found=true
        
        local basename=$(basename "$file" "$SNAPSHOT_EXT")
        local snap_name=$(echo "$metadata" | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
        local snap_hash=$(echo "$metadata" | grep -o '"hash"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
        local snap_branch=$(echo "$metadata" | grep -o '"branch"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
        local snap_created=$(echo "$metadata" | grep -o '"created_at"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/' | sed 's/T/ /' | sed 's/Z//')
        local snap_repo_path=$(echo "$metadata" | grep -o '"repo_path"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
        
        local display_name
        if [ -n "$snap_name" ]; then
            display_name="$snap_name ($snap_hash)"
        else
            display_name="$snap_hash"
        fi
        
        if [ "$show_all" = true ]; then
            echo "  $display_name"
            echo "    repo: $(basename "$snap_repo_path")"
            echo "    branch: $snap_branch | created: $snap_created"
        else
            echo "  $display_name"
            echo "    branch: $snap_branch | created: $snap_created"
        fi
        echo ""
    done
    
    if [ "$found" = false ]; then
        echo "  No snapshots found"
    fi
}

show_snapshot() {
    local query="$1"
    
    if [ -z "$query" ]; then
        echo "Error: Please provide a snapshot name or hash"
        echo "Usage: git-snapshot show <name>"
        exit 1
    fi
    
    ensure_git_repo
    
    local matches=($(find_snapshots "$query" false))
    
    if [ ${#matches[@]} -eq 0 ]; then
        echo "Error: Snapshot '$query' not found"
        exit 1
    fi
    
    if [ ${#matches[@]} -gt 1 ]; then
        echo "Multiple snapshots match '$query':"
        echo ""
        local i=1
        for file in "${matches[@]}"; do
            local metadata=$(get_snapshot_metadata "$file")
            local snap_hash=$(echo "$metadata" | grep -o '"hash"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
            local snap_branch=$(echo "$metadata" | grep -o '"branch"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
            local snap_created=$(echo "$metadata" | grep -o '"created_at"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/' | sed 's/T/ /' | sed 's/Z//')
            echo "  [$i] $snap_hash  $snap_branch  $snap_created"
            ((i++))
        done
        echo ""
        echo "Specify the hash to show a specific snapshot"
        exit 1
    fi
    
    local snapshot_file="${matches[0]}"
    local metadata=$(get_snapshot_metadata "$snapshot_file")
    
    local snap_name=$(echo "$metadata" | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    local snap_hash=$(echo "$metadata" | grep -o '"hash"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    local snap_branch=$(echo "$metadata" | grep -o '"branch"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    local snap_commit=$(echo "$metadata" | grep -o '"commit"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    local snap_created=$(echo "$metadata" | grep -o '"created_at"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/' | sed 's/T/ /' | sed 's/Z//')
    local snap_repo_path=$(echo "$metadata" | grep -o '"repo_path"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    
    echo "Snapshot: $(basename "$snapshot_file" "$SNAPSHOT_EXT")"
    echo "Hash: $snap_hash"
    [ -n "$snap_name" ] && echo "Name: $snap_name"
    echo "Repo: $(basename "$snap_repo_path")"
    echo "Branch: $snap_branch"
    echo "Commit: ${snap_commit:0:8}"
    echo "Created: $snap_created"
    echo ""
    
    # List files (only show actual files, not directories)
    echo "Staged files:"
    local staged=$(tar -tzf "$snapshot_file" 2>/dev/null | grep "^\./staged/." | grep -v "/$" | sed 's|^\./staged/||')
    if [ -n "$staged" ]; then
        echo "$staged" | sed 's/^/  /'
    else
        echo "  (none)"
    fi
    echo ""
    
    echo "Unstaged files:"
    local unstaged=$(tar -tzf "$snapshot_file" 2>/dev/null | grep "^\./unstaged/." | grep -v "/$" | sed 's|^\./unstaged/||')
    if [ -n "$unstaged" ]; then
        echo "$unstaged" | sed 's/^/  /'
    else
        echo "  (none)"
    fi
    echo ""
    
    echo "Untracked files:"
    local untracked=$(tar -tzf "$snapshot_file" 2>/dev/null | grep "^\./untracked/." | grep -v "/$" | sed 's|^\./untracked/||')
    if [ -n "$untracked" ]; then
        echo "$untracked" | sed 's/^/  /'
    else
        echo "  (none)"
    fi
}

restore_snapshot() {
    local query=""
    local restore_staged=true
    local restore_unstaged=true
    local restore_untracked=true
    local selective=false
    
    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            --staged-only)
                selective=true
                restore_staged=true
                restore_unstaged=false
                restore_untracked=false
                shift
                ;;
            --unstaged-only)
                selective=true
                restore_staged=false
                restore_unstaged=true
                restore_untracked=false
                shift
                ;;
            --untracked-only)
                selective=true
                restore_staged=false
                restore_unstaged=false
                restore_untracked=true
                shift
                ;;
            -*)
                echo "Error: Unknown option '$1'"
                exit 1
                ;;
            *)
                query="$1"
                shift
                ;;
        esac
    done
    
    if [ -z "$query" ]; then
        echo "Error: Please provide a snapshot name or hash"
        echo "Usage: git-snapshot restore <name> [--staged-only|--unstaged-only|--untracked-only]"
        exit 1
    fi
    
    ensure_git_repo
    
    local matches=($(find_snapshots "$query" true))
    
    if [ ${#matches[@]} -eq 0 ]; then
        # Try without repo filter to give better error
        local all_matches=($(find_snapshots "$query" false))
        if [ ${#all_matches[@]} -gt 0 ]; then
            echo "Error: Snapshot '$query' belongs to a different repository"
        else
            echo "Error: Snapshot '$query' not found"
        fi
        exit 1
    fi
    
    local snapshot_file
    if [ ${#matches[@]} -gt 1 ]; then
        echo "Multiple snapshots match '$query':"
        echo ""
        local i=1
        for file in "${matches[@]}"; do
            local metadata=$(get_snapshot_metadata "$file")
            local snap_hash=$(echo "$metadata" | grep -o '"hash"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
            local snap_branch=$(echo "$metadata" | grep -o '"branch"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
            local snap_created=$(echo "$metadata" | grep -o '"created_at"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/' | sed 's/T/ /' | sed 's/Z//')
            echo "  [$i] $snap_hash  $snap_branch  $snap_created"
            ((i++))
        done
        echo ""
        read -p "Enter number to restore (or 'q' to quit): " choice
        
        if [ "$choice" = "q" ]; then
            echo "Aborted."
            exit 0
        fi
        
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#matches[@]} ]; then
            echo "Invalid choice"
            exit 1
        fi
        
        snapshot_file="${matches[$((choice-1))]}"
    else
        snapshot_file="${matches[0]}"
    fi
    
    local metadata=$(get_snapshot_metadata "$snapshot_file")
    local repo_path=$(get_repo_path)
    
    # Warn about uncommitted changes if restoring staged/unstaged
    if [ "$restore_staged" = true ] || [ "$restore_unstaged" = true ]; then
        if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
            echo "Warning: You have uncommitted changes that will be overwritten!"
            echo ""
            read -p "Are you sure you want to continue? [y/N] " -n 1 -r
            echo ""
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Aborted."
                exit 1
            fi
        fi
    fi
    
    echo "Restoring snapshot: $(basename "$snapshot_file" "$SNAPSHOT_EXT")"
    [ "$selective" = true ] && echo "(selective restore)"
    echo ""
    
    # Extract to temp directory
    local temp_dir=$(mktemp -d)
    trap "rm -rf '$temp_dir'" EXIT
    
    tar -xzf "$snapshot_file" -C "$temp_dir"
    
    # Discard current changes if restoring staged/unstaged
    if [ "$restore_staged" = true ] || [ "$restore_unstaged" = true ]; then
        echo "Discarding current changes..."
        git checkout -- . 2>/dev/null || true
        git reset HEAD 2>/dev/null || true
    fi
    
    # Restore staged files
    if [ "$restore_staged" = true ] && [ -d "$temp_dir/staged" ]; then
        local count=$(find "$temp_dir/staged" -type f | wc -l | tr -d ' ')
        if [ "$count" -gt 0 ]; then
            echo "Restoring $count staged file(s)..."
            cd "$repo_path"
            find "$temp_dir/staged" -type f | while read -r file; do
                local rel_path="${file#$temp_dir/staged/}"
                local dir=$(dirname "$rel_path")
                mkdir -p "$dir"
                cp "$file" "$rel_path"
                git add "$rel_path"
            done
        fi
    fi
    
    # Restore unstaged files (overwrite working tree)
    if [ "$restore_unstaged" = true ] && [ -d "$temp_dir/unstaged" ]; then
        local count=$(find "$temp_dir/unstaged" -type f | wc -l | tr -d ' ')
        if [ "$count" -gt 0 ]; then
            echo "Restoring $count unstaged file(s)..."
            cd "$repo_path"
            find "$temp_dir/unstaged" -type f | while read -r file; do
                local rel_path="${file#$temp_dir/unstaged/}"
                local dir=$(dirname "$rel_path")
                mkdir -p "$dir"
                cp "$file" "$rel_path"
            done
        fi
    fi
    
    # Restore untracked files
    if [ "$restore_untracked" = true ] && [ -d "$temp_dir/untracked" ]; then
        local count=$(find "$temp_dir/untracked" -type f | wc -l | tr -d ' ')
        if [ "$count" -gt 0 ]; then
            echo "Restoring $count untracked file(s)..."
            cd "$repo_path"
            find "$temp_dir/untracked" -type f | while read -r file; do
                local rel_path="${file#$temp_dir/untracked/}"
                local dir=$(dirname "$rel_path")
                mkdir -p "$dir"
                cp "$file" "$rel_path"
            done
        fi
    fi
    
    echo ""
    echo "Snapshot restored successfully!"
}

delete_snapshots() {
    if [ $# -eq 0 ]; then
        echo "Error: Please provide at least one snapshot name or hash"
        echo "Usage: git-snapshot delete <name> [name2] ..."
        exit 1
    fi
    
    ensure_git_repo
    
    local to_delete=()
    local not_found=()
    
    for query in "$@"; do
        local matches=($(find_snapshots "$query" true))
        
        if [ ${#matches[@]} -eq 0 ]; then
            not_found+=("$query")
        else
            for file in "${matches[@]}"; do
                # Avoid duplicates
                if [[ ! " ${to_delete[*]} " =~ " ${file} " ]]; then
                    to_delete+=("$file")
                fi
            done
        fi
    done
    
    if [ ${#not_found[@]} -gt 0 ]; then
        echo "Error: The following snapshots were not found:"
        for name in "${not_found[@]}"; do
            echo "  $name"
        done
        exit 1
    fi
    
    echo "This will delete ${#to_delete[@]} snapshot(s):"
    for file in "${to_delete[@]}"; do
        echo "  $(basename "$file" "$SNAPSHOT_EXT")"
    done
    echo ""
    
    read -p "Are you sure? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
    
    for file in "${to_delete[@]}"; do
        rm "$file"
        echo "Deleted: $(basename "$file")"
    done
    
    echo ""
    echo "${#to_delete[@]} snapshot(s) deleted."
}

prune_snapshots() {
    ensure_git_repo
    
    local snapshots=($(list_repo_snapshots))
    
    if [ ${#snapshots[@]} -eq 0 ]; then
        echo "No snapshots to prune for this repository."
        exit 0
    fi
    
    echo "This will delete ALL ${#snapshots[@]} snapshot(s) for this repository:"
    echo ""
    for file in "${snapshots[@]}"; do
        echo "  $(basename "$file" "$SNAPSHOT_EXT")"
    done
    echo ""
    
    read -p "Are you sure you want to delete ALL snapshots? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
    
    for file in "${snapshots[@]}"; do
        rm "$file"
        echo "Deleted: $(basename "$file")"
    done
    
    echo ""
    echo "All snapshots pruned."
}

rename_snapshot() {
    local query="$1"
    local new_name="$2"
    
    if [ -z "$query" ] || [ -z "$new_name" ]; then
        echo "Error: Please provide snapshot name/hash and new name"
        echo "Usage: git-snapshot rename <name> <new-name>"
        exit 1
    fi
    
    ensure_git_repo
    
    local matches=($(find_snapshots "$query" true))
    
    if [ ${#matches[@]} -eq 0 ]; then
        echo "Error: Snapshot '$query' not found"
        exit 1
    fi
    
    if [ ${#matches[@]} -gt 1 ]; then
        echo "Error: Multiple snapshots match '$query'. Specify the hash."
        exit 1
    fi
    
    local snapshot_file="${matches[0]}"
    local metadata=$(get_snapshot_metadata "$snapshot_file")
    local snap_hash=$(echo "$metadata" | grep -o '"hash"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*: *"\([^"]*\)"/\1/')
    
    # Build new filename
    local new_filename="${new_name}.${snap_hash}${SNAPSHOT_EXT}"
    local new_path="$SNAPSHOTS_DIR/$new_filename"
    
    if [ -f "$new_path" ]; then
        echo "Error: Snapshot '$new_filename' already exists"
        exit 1
    fi
    
    # Extract, update metadata, repack
    local temp_dir=$(mktemp -d)
    trap "rm -rf '$temp_dir'" EXIT
    
    tar -xzf "$snapshot_file" -C "$temp_dir"
    
    # Update name in metadata
    if command -v jq &> /dev/null; then
        jq ".name = \"$new_name\"" "$temp_dir/metadata.json" > "$temp_dir/metadata.json.tmp"
        mv "$temp_dir/metadata.json.tmp" "$temp_dir/metadata.json"
    else
        sed -i.bak "s/\"name\"[[:space:]]*:[[:space:]]*\"[^\"]*\"/\"name\": \"$new_name\"/" "$temp_dir/metadata.json"
        rm -f "$temp_dir/metadata.json.bak"
    fi
    
    # Create new snapshot
    tar -czf "$new_path" -C "$temp_dir" .
    
    # Remove old snapshot
    rm "$snapshot_file"
    
    echo "Renamed: $(basename "$snapshot_file") -> $new_filename"
}

# ============================================================================
# Main
# ============================================================================

case "${1:-}" in
    help|--help|-h)
        show_help
        ;;
    list)
        shift
        list_snapshots "$@"
        ;;
    show)
        show_snapshot "$2"
        ;;
    restore)
        shift
        restore_snapshot "$@"
        ;;
    delete|rm)
        shift
        delete_snapshots "$@"
        ;;
    prune)
        prune_snapshots
        ;;
    rename)
        rename_snapshot "$2" "$3"
        ;;
    create)
        create_snapshot "$2"
        ;;
    *)
        create_snapshot "$1"
        ;;
esac
